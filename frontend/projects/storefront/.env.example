# SSR server settings (ADR-04 rules 5-8). Placeholders only - real values come from the server environment
# (local secrets in development) and are never committed. Each key is random and at least 32 characters.

# Edge -> SSR credential, verified before anything is rendered.
PLATFORM_SSR_INGRESS_KEY=<random value, at least 32 characters>
# Optional: the previous ingress key, accepted during rotation.
# PLATFORM_SSR_INGRESS_KEY_PREVIOUS=<previous value>

# SSR -> API credential, accepted by the API for allow-listed public GETs only. Must differ from the ingress key.
PLATFORM_SSR_API_KEY=<random value, at least 32 characters>

# Origin of the private API (no path, no credentials).
INTERNAL_API_BASE_URL=http://localhost:5000

# Production (default) | Testing. The test diagnostic is allowed only in Testing.
# PLATFORM_ENVIRONMENT=Production
# PLATFORM_ENABLE_TEST_DIAGNOSTICS=false

# Never set PLATFORM_API_EDGE_KEY here: the SSR server must not hold the API edge key (startup fails - TH-14).
