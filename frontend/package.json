{
  "name": "platform-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "dev:storefront": "ng serve storefront --port 4200",
    "dev:admin": "ng serve admin --port 4300",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:storefront": "node dist/storefront/server/server.mjs",
    "build:all": "ng build storefront && ng build admin",
    "test:all": "ng test storefront --watch=false && ng test admin --watch=false && ng test i18n --watch=false",
    "contracts:generate": "openapi-typescript ../contracts/openapi.json --output projects/api-contracts/src/lib/schema.d.ts",
    "contracts:check": "openapi-typescript ../contracts/openapi.json --output projects/api-contracts/src/lib/schema.d.ts --check",
    "lint": "ng lint",
    "test:ssr": "node --test \"projects/storefront/server-tests/*.test.mjs\"",
    "scan:bundles": "node ../scripts/scan-browser-bundles.mjs",
    "e2e": "playwright test"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/platform-server": "22.2.3",
    "@angular/router": "22.2.3",
    "@angular/ssr": "22.2.3",
    "express": "5.3.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.3",
    "@angular/cli": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@angular/localize": "22.2.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "angular-eslint": "22.6.0",
    "eslint": "10.13.0",
    "jsdom": "30.1.3",
    "ng-packagr": "22.2.4",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "24.15.0",
    "npm": "11.12.1"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    },
    "@angular/build": {
      "vite": "8.3.4"
    }
  }
}
